FROM alpine:3.22
RUN apk add --no-cache bash tzdata ca-certificates nftables
RUN wget -q -O /usr/local/bin/sing-box https://github.com/ANIMO-TECH/sing-box/releases/download/proxy-auth-55a9be55/sing-box-amd64 \
    && echo "040f4ba2af322c1244ca4589d2ea1b638a92c2745fa95f457efe8b8141445548  /usr/local/bin/sing-box" | sha256sum -c - \
    && chmod 755 /usr/local/bin/sing-box
ENTRYPOINT ["sing-box", "run", "-c", "/etc/sing-box/config.json"]
