FROM alpine:3.22
RUN apk add --no-cache bash tzdata ca-certificates nftables
RUN wget -q -O /usr/local/bin/sing-box https://github.com/ANIMO-TECH/sing-box/releases/download/proxy-auth-fedf390e/sing-box-amd64 \
    && echo "621a5b2039c8e8d6fc7bb3668404c67d6a348b6253bd3606c2a6700e26493e44  /usr/local/bin/sing-box" | sha256sum -c - \
    && chmod 755 /usr/local/bin/sing-box
ENTRYPOINT ["sing-box", "run", "-c", "/etc/sing-box/config.json"]
